# Datos descargados (pesados; se regeneran con 1_descargar.py). Los sondeos sí
# se guardan: son pequeños y respaldan el atraso de publicación y la cobertura.
datos/*
!datos/sondeos/

# Paneles intermedios: pesan, los arma el paso 2b y los notebooks no los leen
paneles/panel_horario.csv.gz
paneles/panel_horario_completo.csv.gz
# copia sin comprimir de panel_lstm_modelo.csv.gz
paneles/panel_lstm_modelo.csv/

# Datos y cachés del pipeline anterior, archivados en legacy/
cache_*/
data/
datos_simem/
*.parquet
legacy/paneles/
legacy/seleccion_lineal/*.csv.gz

# Material de terceros (tesis, papers y repos guía) y documentos personales
material_de_apoyo/

# Configuración local del editor
.claude/
.vscode/

# Copias de seguridad internas (redundantes con el historial de git)
respaldo_*/

# Python y Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Sistema operativo y otros programas
.DS_Store
Thumbs.db
*.log

# Temporales que crea Word mientras un documento está abierto
~$*

# Periodo limpio (paso 9f): se guardan los paneles finales y la comprobación; los datos crudos,
# las copias de los pasos y los paneles intermedios se regeneran
periodo_limpio/*
!periodo_limpio/paneles/
!periodo_limpio/comprobacion_paneles.csv
periodo_limpio/paneles/*
!periodo_limpio/paneles/panel_horario_modelo.csv.gz
!periodo_limpio/paneles/panel_horario_modelo_columnas.csv
!periodo_limpio/paneles/panel_lstm_bloques.csv.gz
!periodo_limpio/paneles/panel_lstm_bloques_variables.csv
